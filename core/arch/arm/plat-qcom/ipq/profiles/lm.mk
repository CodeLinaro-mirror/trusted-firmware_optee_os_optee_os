CFG_CRYPTO_SHA3_256 ?= n
CFG_CRYPTO_SHA3_384 ?= n
CFG_CRYPTO_SHA3_512 ?= n
CFG_CRYPTO_SHAKE128 ?= n
CFG_CRYPTO_SHAKE256 ?= n
CFG_CRYPTO_CONCAT_KDF ?= n
