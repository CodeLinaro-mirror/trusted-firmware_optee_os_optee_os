ifneq (,$(filter $(PLATFORM_FLAVOR),$(ipq52xx-flavorlist)))

CFG_IPQ52XX ?= y

# Hardware configuration
# 4 cores (4 Cortex-A53) in a single cluster
CFG_TEE_CORE_NB_CORE ?= 4
# Use log2(4)=2 to accommodate all 4 cores in the cluster
CFG_CORE_CLUSTER_SHIFT ?= 2

# IPQ52xx GIC(v2) configuration
CFG_GIC ?= y
CFG_GIC_BASE ?= 0xB000000
CFG_GIC_SIZE ?= 0x5000
CFG_GICD_OFFSET ?= 0x0
CFG_GICC_OFFSET ?= 0x2000

# IPQ52xx doesn't require HWRNG PTA since it has SoC RNG for HLOS use-cases
CFG_HWRNG_PTA ?= n

CFG_TZDRAM_START ?= 0x8A680000

# DDR memory configuration
CFG_DRAM0_BASE ?= 0x80000000
CFG_DRAM0_SIZE ?= 0x80000000
CFG_DRAM1_BASE ?= 0x800000000
CFG_DRAM1_SIZE ?= 0x80000000

# DIAG logging support
CFG_QCOM_DIAG_LOG ?= y
CFG_QCOM_DIAG_BASE ?= 0x8608000
CFG_QCOM_DIAG_SIZE ?= 0x6000
CFG_QCOM_DIAG_LOG_START_INFO ?= 0x8600730
CFG_QCOM_DIAG_LOG_SIZE_INFO ?= 0x8600734
CFG_QCOM_TCSR_BOOT_MISC_DETECT ?= 0x195C100

# TME IPC support
CFG_QCOM_TMEL_COM ?= y
CFG_TME_QMP_IRQ_IN_ID ?= 100u
CFG_TME_QMP_IRQ_OUT_REG_ADDR ?= 0x0B111004
CFG_TME_QMP_IRQ_OUT_BIT_MASK ?= 0x00200000
CFG_TME_QMP_INBOUND_MBOX_ADDR ?= 0x32090000
CFG_TME_QMP_OUTBOUND_MBOX_ADDR ?= 0x32091000

# FEATURE_CONFIG2 fuse register - indicates if TMEL is bypassed on this part
CFG_QCOM_FEATURE_CONFIG2_ADDR ?= 0xA600C
endif
